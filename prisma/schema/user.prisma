
model User {
  id String @id @default(uuid())
  email String @unique
  password String
  name String
  refreshToken RefreshToken[]
  roles ERole[] @default([CUSTOMER])
  ownerProfile OwnerProfile?
  courierProfile CourierProfile?

  createdAt DateTime  @default(now())
}

model OwnerProfile {
  id String @id @default(uuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  vouchers Voucher[]
  companyName    String
  phone          String
  isVerified     Boolean  @default(false) 
  createdAt DateTime @default(now())
}

model CourierProfile {
  id String @id @default(uuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone          String
  vehicleType    EVehicleType[]
  isVerified     Boolean  @default(false)  // прошёл ли проверку
  isOnline       Boolean  @default(false)  // готов ли принимать заказы ?
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}