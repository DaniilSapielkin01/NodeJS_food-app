model Product {
  id String @id @default(uuid())
  name String @unique
  image String
  description String
  price Decimal
  discount String
  inStock Boolean @default(true)
  count Int @default(0)
  voucherId String
  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  stores Store[]
  orderItems OrderItem[]

  createdAt DateTime @default(now()) 

  @@index([voucherId])
}