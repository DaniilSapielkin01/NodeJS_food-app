model Store {
  id String @id @default(uuid())
  name String
  description String?
  image String?
  address String
  voucherId String
  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  products Product[]
  orders Order[]

  createdAt DateTime @default(now())
  
  @@index([voucherId])
}